server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/mental_health_assistant?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    username: root
    password: 在这里填你的数据库密码
    driver-class-name: com.mysql.cj.jdbc.Driver

# JWT配置
jwt:
  secret: 在这里填一个足够长的随机密钥（上线务必替换）
  expiration: 86400000 # 24小时(毫秒)
  refresh-expiration: 604800000 # 7天(毫秒)
  header: Authorization # token头部名称
  token-prefix: "Bearer " # token前缀
